[Unit]
Description=Mount EBS volumes for /home and /data (and optional swap setup)

# Ordered AFTER local-fs.target, deliberately. This unit's script checks whether
# /home is already a mountpoint before deciding what to do, so it must not run
# before the fstab mounts it depends on. Note that Wants= is a dependency, not an
# ordering: dropping Before= without adding After= leaves the race in place and
# only stops it blocking the boot.
#
# Everything the script needs (/home, /data, /opt/dlami/nvme) is mounted from
# fstab by UUID, so running afterwards is both correct and race-free. On a fresh
# instance fstab has no entries yet, local-fs.target completes without them, and
# this unit then creates them -- which is why jupyterhub.service declares
# Requires=/After= on this unit rather than on local-fs.target.
After=local-fs.target
After=lvm2-monitor.service
Wants=lvm2-monitor.service

ConditionPathExists=/usr/local/sbin/mount-ebs-volumes.sh

# No-op until install-jupyterhub-service.sh has installed the handler; systemd
# simply logs that the dependency is missing rather than failing this unit.
OnFailure=jupyterhub-failure-notify@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mount-ebs-volumes.sh

# Type=oneshot defaults to TimeoutStartSec=infinity. Without an explicit bound, a
# hang blocks boot forever with no recovery path except the serial console. Fail
# loudly instead; the unit is pulled in by a Wants, so a failure leaves a
# reachable host with one failed service.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
