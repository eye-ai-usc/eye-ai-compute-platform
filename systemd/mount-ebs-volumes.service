[Unit]
Description=Mount EBS volumes for /home and /data (and optional swap setup)
DefaultDependencies=no
After=local-fs-pre.target systemd-udev-settle.service
Wants=local-fs.target systemd-udev-settle.service
Before=local-fs.target

ConditionPathExists=/usr/local/sbin/mount-ebs-volumes.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mount-ebs-volumes.sh

[Install]
WantedBy=local-fs.target
